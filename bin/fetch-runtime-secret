#!/usr/bin/env php
<?php

declare(strict_types=1);

use Amtgard\HostEnvVault\Cli\FetchRuntimeSecretArgvParser;
use Amtgard\HostEnvVault\Cli\FetchRuntimeSecretCommand;
use Amtgard\HostEnvVault\Cli\FetchRuntimeSecretUsageException;

require dirname(__DIR__) . '/vendor/autoload.php';

$parser = new FetchRuntimeSecretArgvParser();

try {
    $options = $parser->parse($argv);
} catch (FetchRuntimeSecretUsageException $e) {
    fwrite(STDERR, $e->getMessage() . "\n");
    exit(FetchRuntimeSecretArgvParser::EXIT_USAGE);
}

try {
    $secret = (new FetchRuntimeSecretCommand($options))->run();
} catch (Throwable $e) {
    fwrite(STDERR, $e->getMessage() . "\n");
    exit(1);
}

fwrite(STDOUT, $secret);

exit(FetchRuntimeSecretArgvParser::EXIT_OK);
